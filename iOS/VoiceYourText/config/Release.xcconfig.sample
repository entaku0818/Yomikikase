// RevenueCat API Key for Production environment
// Replace YOUR_PRODUCTION_API_KEY with your actual production API key
REVENUECAT_API_KEY = appl_YOUR_PRODUCTION_API_KEY 

// AdMob 広告ユニットID（本番）
// ⚠️ テストID（ca-app-pub-3940256099942544/...）やプレースホルダのままだと
//    Releaseビルドは "Validate AdMob Ad Unit IDs" フェーズで失敗します。
//    本番IDは AdMob 管理画面 > アプリ「Voice Narrator Text-to-speech」
//    (ca-app-pub-3484697221349891~7968499014) > 広告ユニット から取得。
ADMOB_BANNER_ID = ca-app-pub-3484697221349891/XXXXXXXXXX
ADMOB_APP_OPEN_ID = ca-app-pub-3484697221349891/XXXXXXXXXX
