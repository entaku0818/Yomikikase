    "%lld日間無料・約38%%お得": {
      "comment": "A badge at the top of the checkout view indicating a free trial and a discount. The argument is the number of trial days.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Tage kostenlos · ca. 38%% Ersparnis"
          }
        },
