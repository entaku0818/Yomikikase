          "stringUnit": {
            "state": "needs_review",
            "value": "Terima kasih atas maklum balas anda. Ia akan membantu kita bertambah baik."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങളുടെ ഫീഡ്‌ബാക്കിന് നന്ദി. അത് നമ്മെ മെച്ചപ്പെടുത്താൻ സഹായിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुमच्या अभिप्रायाबद्दल धन्यवाद. ते आम्हाला सुधारण्यास मदत करेल."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Takk for tilbakemeldingen. Det vil hjelpe oss å forbedre oss."
          }
        },
        "or": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ଆପଣଙ୍କ ମତାମତ ପାଇଁ ଧନ୍ୟବାଦ | ଏହା ଆମକୁ ଉନ୍ନତି କରିବାରେ ସାହାଯ୍ୟ କରିବ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dziękujemy za Twoją opinię. Pomoże nam to się ulepszyć."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Obrigado pelo seu feedback. Isso ajudar-nos-á a melhorar."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ਤੁਹਾਡੇ ਫੀਡਬੈਕ ਲਈ ਧੰਨਵਾਦ। ਇਹ ਸਾਨੂੰ ਸੁਧਾਰਨ ਵਿੱਚ ਮਦਦ ਕਰੇਗਾ।"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vă mulțumim pentru feedback. Ne va ajuta să ne îmbunătățim."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ďakujeme za spätnú väzbu. Pomôže nám to zlepšiť sa."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvala za vaše povratne informacije. To nam bo pomagalo izboljšati."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Gracias por tus comentarios. Nos ayudarán a mejorar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tack för din feedback. Det kommer att hjälpa oss att förbättra oss."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "உங்கள் கருத்துக்கு நன்றி. அது நம்மை மேம்படுத்த உதவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "మీ అభిప్రాయానికి ధన్యవాదాలు. ఇది మెరుగుపరచడానికి మాకు సహాయం చేస్తుంది."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Дякуємо за відгук. Це допоможе нам покращитися."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "آپ کی رائے کا شکریہ۔ اس سے ہمیں بہتر بنانے میں مدد ملے گی۔"
          }
        }
      }
    },
