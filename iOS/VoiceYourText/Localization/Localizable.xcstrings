        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No incluyas información personal ni documentos originales. Las respuestas se envían con la versión de la app, del sistema y datos del dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N’incluez ni données personnelles ni documents originaux. Les réponses sont envoyées avec les versions de l’app et du système ainsi que les informations de l’appareil."
