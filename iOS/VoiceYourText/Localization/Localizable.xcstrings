        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "...एक बर्फीले देश में उभरा। नीचे से रात सफ़ेद हो गयी थी। एक ट्रेन सिग्नल स्टेशन पर रुकी."
