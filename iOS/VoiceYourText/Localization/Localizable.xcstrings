        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Izberite glas, da slišite vzorec. Uporabljen bo od naslednjega predvajanja."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona una voz para escucharla. Se usará a partir de la próxima reproducción."
          }
