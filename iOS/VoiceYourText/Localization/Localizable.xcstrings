            "value": "Ott folytatódik, ahol abbahagyta"
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Melanjutkan dari bagian terakhir yang Anda tinggalkan"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ನೀವು ನಿಲ್ಲಿಸಿದ ಸ್ಥಳದಿಂದ ಪುನರಾರಂಭವಾಗುತ್ತದೆ"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Menyambung semula tempat anda berhenti"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "നിങ്ങൾ നിർത്തിയിടത്ത് നിന്ന് പുനരാരംഭിക്കുന്നു"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "तुम्ही जिथे सोडले होते तेथून सुरू होते"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fortsetter der du slapp"
          }
        },
        "or": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ଯେଉଁଠାରେ ଆପଣ ଛାଡିଛନ୍ତି ପୁନ umes କାର୍ଯ୍ୟ ଆରମ୍ଭ କରନ୍ତୁ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wznawia w miejscu, w którym przerwałeś"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Retoma de onde parou"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ਮੁੜ ਸ਼ੁਰੂ ਹੁੰਦਾ ਹੈ ਜਿੱਥੇ ਤੁਸੀਂ ਛੱਡਿਆ ਸੀ"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Reia de unde ai plecat"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pokračuje tam, kde ste skončili"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nadaljuje tam, kjer ste končali"
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuará donde lo dejaste"
          }
        },
        "sv": {
          "stringUnit": {
