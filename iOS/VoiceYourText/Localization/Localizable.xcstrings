        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "উচ্চ মানের ভয়েসগুলি ইতিমধ্যেই এই ডিভাইসে ডাউনলোড করা হয়েছে৷ আরো স্বাভাবিক পড়ার জন্য একটি নির্বাচন করুন."
          }
        },
        "ca": {
          "stringUnit": {
