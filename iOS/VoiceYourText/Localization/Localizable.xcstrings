        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "उदाहरण के लिए: अध्ययन नोट्स, उपन्यास या वेब लेख। यदि आपने अभी तक ऐप का उपयोग नहीं किया है, तो आप क्या सुनना चाहेंगे?"
