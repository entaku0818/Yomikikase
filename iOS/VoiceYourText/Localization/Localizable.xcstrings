        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "מחק לצמיתות את \"%@\". לא ניתן לבטל פעולה זו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "\"%@\" को स्थायी रूप से हटा दें। इस एक्शन को वापस नहीं किया जा सकता।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A \"%@\" végleg törlése. Ez a művelet nem vonható vissza."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hapus \"%@\" secara permanen. Tindakan ini tidak dapat dibatalkan."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "\"%@\" ಅನ್ನು ಶಾಶ್ವತವಾಗಿ ಅಳಿಸಿ. ಈ ಕ್ರಿಯೆಯನ್ನು ರದ್ದುಗೊಳಿಸಲಾಗುವುದಿಲ್ಲ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Padamkan \"%@\" secara kekal. Tindakan ini tidak boleh dibuat asal."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "\"%@\" ശാശ്വതമായി ഇല്ലാതാക്കുക. ഈ പ്രവർത്തനം പഴയപടിയാക്കാനാകില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "\"%@\" कायमचे हटवा. ही क्रिया पूर्ववत केली जाऊ शकत नाही."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Slett \"%@\" permanent. Denne handlingen kan ikke angres."
          }
        },
        "or": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ସ୍ଥାୟୀ ଭାବରେ \"%@\" ବିଲୋପ କରନ୍ତୁ | ଏହି କାର୍ଯ୍ୟକୁ ପୂର୍ବବତ୍ କରାଯାଇପାରିବ ନାହିଁ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usuń trwale „%@”. Tej akcji nie można cofnąć."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Apague permanentemente \"%@\". Esta ação não pode ser anulada."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "\"%@\" ਨੂੰ ਸਥਾਈ ਤੌਰ 'ਤੇ ਮਿਟਾਓ। ਇਸ ਕਾਰਵਾਈ ਨੂੰ ਅਣਕੀਤਾ ਨਹੀਂ ਕੀਤਾ ਜਾ ਸਕਦਾ।"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ștergeți definitiv „%@”. Această acțiune nu poate fi anulată."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Natrvalo odstrániť „%@“. Túto akciu nie je možné vrátiť späť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Trajno izbriši »%@«. Tega dejanja ni mogoče razveljaviti."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar permanentemente \"%@\". Esta acción no se puede deshacer."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ta bort \"%@\" permanent. Denna åtgärd kan inte ångras."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "\"%@\" ஐ நிரந்தரமாக நீக்கவும். இந்தச் செயலைச் செயல்தவிர்க்க முடியாது."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "\"%@\"ని శాశ్వతంగా తొలగించండి. ఈ చర్య రద్దు చేయబడదు."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Видалити \"%@\" назавжди. Цю дію не можна скасувати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "\"%@\" کو مستقل طور پر حذف کریں۔ اس کارروائی کو کالعدم نہیں کیا جا سکتا۔"
          }
        }
      }
    },
