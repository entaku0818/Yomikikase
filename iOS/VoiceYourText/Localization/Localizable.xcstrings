        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For example: study notes, novels or web articles. If you have not used the app yet, what would you like to hear?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por exemplo: anotações de estudo, romances ou artigos da web. Se ainda não usou o app, o que gostaria de ouvir?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Например: конспекты, романы или статьи из интернета. Если вы ещё не пользовались приложением, что хотели бы послушать?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "例如：学习笔记、小说或网络文章。如果您尚未使用本应用，您想收听什么？"
