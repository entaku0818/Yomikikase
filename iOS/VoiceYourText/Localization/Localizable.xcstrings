    "テキスト・PDF・ウェブ・電子書籍を\n声に出して読んでくれるアプリです": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine App, die Text, PDFs,\nWebseiten und E-Books für Sie vorliest"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An app that reads text, PDFs,\nweb pages, and e-books aloud for you"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una app que lee en voz alta texto, PDFs,\npáginas web y libros electrónicos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
