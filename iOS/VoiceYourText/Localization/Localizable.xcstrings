            "value": "Fortsätter där du slutade"
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "நீங்கள் விட்ட இடத்திலிருந்து தொடர்கிறது"
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "మీరు ఆపివేసిన చోటే మళ్లీ ప్రారంభమవుతుంది"
          }
        },
        "uk": {
