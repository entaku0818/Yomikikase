          "stringUnit": {
            "state": "needs_review",
            "value": "ಗಟ್ಟಿಯಾಗಿ ಓದುವಾಗ ಯಾವುದೇ ಜಾಹೀರಾತು ಬ್ಯಾನರ್‌ಗಳಿಲ್ಲ, ಆದ್ದರಿಂದ ನೀವು ಗಮನಹರಿಸಬಹುದು."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tiada sepanduk iklan semasa membaca dengan kuat, jadi anda boleh kekal fokus."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഉറക്കെ വായിക്കുമ്പോൾ പരസ്യ ബാനറുകളൊന്നുമില്ല, അതിനാൽ നിങ്ങൾക്ക് ശ്രദ്ധ കേന്ദ്രീകരിക്കാനാകും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "मोठ्याने वाचताना कोणतेही जाहिरात बॅनर नाहीत, त्यामुळे तुम्ही लक्ष केंद्रित करू शकता."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ingen annonsebannere mens du leser høyt, så du kan holde fokus."
          }
        },
        "or": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ଉଚ୍ଚ ସ୍ୱରରେ ପ reading ିବା ସମୟରେ କ ad ଣସି ବିଜ୍ଞାପନ ବ୍ୟାନର ନାହିଁ, ତେଣୁ ଆପଣ ଧ୍ୟାନରେ ରହିପାରିବେ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Brak banerów reklamowych podczas czytania na głos, dzięki czemu możesz się skupić."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não há banners publicitários durante a leitura em voz alta, para que possa manter o foco."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ਉੱਚੀ ਆਵਾਜ਼ ਵਿੱਚ ਪੜ੍ਹਦੇ ਸਮੇਂ ਕੋਈ ਵਿਗਿਆਪਨ ਬੈਨਰ ਨਹੀਂ, ਇਸ ਲਈ ਤੁਸੀਂ ਫੋਕਸ ਰਹਿ ਸਕਦੇ ਹੋ।"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fără bannere publicitare în timp ce citiți cu voce tare, astfel încât să puteți rămâne concentrat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Žiadne reklamné bannery pri čítaní nahlas, takže sa môžete sústrediť."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Med branjem na glas ni oglasnih pasic, tako da lahko ostanete osredotočeni."
          }
        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin banners publicitarios durante la lectura, para que te concentres."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inga annonsbanners när du läser högt, så du kan hålla fokus."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "சத்தமாக வாசிக்கும் போது விளம்பர பேனர்கள் இல்லை, எனவே நீங்கள் கவனம் செலுத்தலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "బిగ్గరగా చదివేటప్పుడు ప్రకటన బ్యానర్‌లు లేవు, కాబట్టి మీరు దృష్టి కేంద్రీకరించవచ్చు."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Немає рекламних банерів під час читання вголос, тому ви можете зосередитися."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "needs_review",
            "value": "بلند آواز میں پڑھتے وقت کوئی اشتہاری بینر نہیں، تاکہ آپ توجہ مرکوز رکھ سکیں۔"
          }
        }
      }
    },
