    "survey.content.placeholder": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例：勉強の資料、小説、Web記事。未使用の方は聴いてみたいものを教えてください。"
