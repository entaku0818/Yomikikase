        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ये आवाज़ें मानक iOS आवाज़ों की तुलना में अधिक स्वाभाविक लगती हैं। एक बार डाउनलोड होने के बाद, वे ऑफ़लाइन काम करते हैं।"
