        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "אפליקציה שקוראת טקסט, קובצי PDF,\nדפי אינטרנט וספרים אלקטרוניים עבורך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "एक ऐप जो टेक्स्ट, पीडीएफ़ पढ़ता है,\nवेब पेज और ई-पुस्तकें आपके लिए ज़ोरदार हैं"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
