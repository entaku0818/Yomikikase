          }
        },
        "en-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "Please do not include personal information or original documents. Answers are sent with your app version, OS version and device information."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "translated",
            "value": "Please do not include personal information or original documents. Answers are sent with your app version, OS version and device information."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Älä liitä mukaan henkilötietoja tai alkuperäisiä asiakirjoja. Vastaukset lähetetään sovellusversiosi, käyttöjärjestelmäversiosi ja laitetietojen kanssa."
