        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pilih suara untuk didengarkan sampelnya. Ini akan digunakan mulai pemutaran berikutnya."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಮಾದರಿಯನ್ನು ಕೇಳಲು ಧ್ವನಿಯನ್ನು ಆಯ್ಕೆಮಾಡಿ. ಮುಂದಿನ ಪ್ಲೇಬ್ಯಾಕ್‌ನಿಂದ ಇದನ್ನು ಬಳಸಲಾಗುವುದು."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pilih suara untuk mendengar sampel. Ia akan digunakan dari main balik seterusnya."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഒരു സാമ്പിൾ കേൾക്കാൻ ഒരു ശബ്ദം തിരഞ്ഞെടുക്കുക. അടുത്ത പ്ലേബാക്ക് മുതൽ ഇത് ഉപയോഗിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "नमुना ऐकण्यासाठी आवाज निवडा. पुढील प्लेबॅकपासून ते वापरले जाईल."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Velg en stemme for å høre et eksempel. Den vil bli brukt fra neste avspilling."
          }
        },
        "or": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ଏକ ନମୁନା ଶୁଣିବାକୁ ଏକ ସ୍ୱର ବାଛନ୍ତୁ | ପରବର୍ତ୍ତୀ ପ୍ଲେକ୍ ଠାରୁ ଏହା ବ୍ୟବହୃତ ହେବ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wybierz głos, aby usłyszeć próbkę. Będzie on używany od następnego odtwarzania."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Selecione uma voz para ouvir uma amostra. Será usado na próxima reprodução."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ਇੱਕ ਨਮੂਨਾ ਸੁਣਨ ਲਈ ਇੱਕ ਆਵਾਜ਼ ਚੁਣੋ। ਇਸਦੀ ਵਰਤੋਂ ਅਗਲੇ ਪਲੇਬੈਕ ਤੋਂ ਕੀਤੀ ਜਾਵੇਗੀ।"
          }
        },
        "ro": {
          "stringUnit": {
