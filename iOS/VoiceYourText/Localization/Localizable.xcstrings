    "フィードバックをありがとうございます。今後の改善に役立てます。": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vielen Dank für Ihr Feedback. Es hilft uns, uns zu verbessern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thank you for your feedback. It will help us improve."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gracias por tus comentarios. Nos ayudarán a mejorar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci pour vos commentaires. Cela nous aidera à nous améliorer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grazie per il tuo feedback. Ci aiuterà a migliorare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィードバックをありがとうございます。今後の改善に役立てます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피드백 감사합니다. 향후 개선에 도움이 됩니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอบคุณสำหรับข้อเสนอแนะ จะช่วยให้เราปรับปรุงได้ในอนาคต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri bildiriminiz için teşekkürler. Geliştirmemize yardımcı olacak."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cảm ơn phản hồi của bạn. Sẽ giúp chúng tôi cải thiện trong tương lai."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrigado pelo feedback. Ele nos ajudará a melhorar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спасибо за отзыв. Он поможет нам улучшить приложение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "感谢您的反馈，我们将用它来改进应用。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "شكرا لتعليقاتك. وسوف يساعدنا على التحسن."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার মতামতের জন্য আপনাকে ধন্যবাদ. এটা আমাদের উন্নতি করতে সাহায্য করবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gràcies pels teus comentaris. Ens ajudarà a millorar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "感謝您的回饋。它將幫助我們改進。"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Hvala vam na povratnim informacijama. To će nam pomoći da se poboljšamo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "děkujeme za vaši zpětnou vazbu. Pomůže nám to zlepšit se."
