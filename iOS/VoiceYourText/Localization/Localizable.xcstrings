        },
        "es-MX": {
          "stringUnit": {
            "state": "translated",
            "value": "Se restablece el %@. Puedes continuar con la voz del dispositivo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den återställs på %@. Du kan fortsätta med din enhets röst."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "இது %@ இல் மீட்டமைக்கப்படும். உங்கள் சாதனத்தின் குரலைத் தொடரலாம்."
          }
