        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non includere dati personali o documenti originali. Le risposte vengono inviate con la versione dell’app, del sistema e le informazioni del dispositivo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인정보나 원본 문서를 포함하지 마세요. 답변은 앱 버전, OS 버전, 기기 정보와 함께 전송됩니다."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรดอย่าใส่ข้อมูลส่วนตัวหรือเอกสารต้นฉบับ คำตอบจะส่งพร้อมเวอร์ชันแอป ระบบ และข้อมูลอุปกรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişisel bilgi veya özgün belgeler eklemeyin. Yanıtlar uygulama sürümü, işletim sistemi sürümü ve cihaz bilgileriyle gönderilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không gửi thông tin cá nhân hoặc tài liệu gốc. Câu trả lời được gửi kèm phiên bản ứng dụng, hệ điều hành và thông tin thiết bị."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يرجى عدم تضمين المعلومات الشخصية أو المستندات الأصلية. يتم إرسال الإجابات مع إصدار التطبيق وإصدار نظام التشغيل ومعلومات الجهاز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ব্যক্তিগত তথ্য বা মূল নথি অন্তর্ভুক্ত করবেন না দয়া করে. আপনার অ্যাপ সংস্করণ, OS সংস্করণ এবং ডিভাইসের তথ্য সহ উত্তর পাঠানো হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Si us plau, no inclogueu informació personal ni documents originals. Les respostes s'envien amb la versió de l'aplicació, la versió del sistema operatiu i la informació del dispositiu."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "請不要包含個人資訊或原始文件。答案將與您的應用程式版本、作業系統版本和裝置資訊一起發送。"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nemojte uključivati osobne podatke ili originalne dokumente. Odgovori se šalju s vašom verzijom aplikacije, verzijom OS-a i informacijama o uređaju."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Neuvádějte prosím osobní údaje ani originální dokumenty. Odpovědi jsou odesílány s verzí vaší aplikace, verzí operačního systému a informacemi o zařízení."
          }
        },
        "da": {
