        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಪಠ್ಯ, PDF ಗಳನ್ನು ಓದುವ ಅಪ್ಲಿಕೇಶನ್,\nವೆಬ್ ಪುಟಗಳು ಮತ್ತು ಇ-ಪುಸ್ತಕಗಳು ನಿಮಗಾಗಿ ಗಟ್ಟಿಯಾಗಿ"
