        "fr-CA": {
          "stringUnit": {
            "state": "translated",
            "value": "N’incluez ni données personnelles ni documents originaux. Les réponses sont envoyées avec les versions de l’app et du système ainsi que les informations de l’appareil."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Μην συμπεριλάβετε προσωπικά στοιχεία ή πρωτότυπα έγγραφα. Οι απαντήσεις αποστέλλονται με την έκδοση της εφαρμογής σας, την έκδοση του λειτουργικού συστήματος και τις πληροφορίες της συσκευής σας."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "કૃપા કરીને વ્યક્તિગત માહિતી અથવા મૂળ દસ્તાવેજો શામેલ કરશો નહીં. જવાબો તમારા એપ્લિકેશન સંસ્કરણ, OS સંસ્કરણ અને ઉપકરણ માહિતી સાથે મોકલવામાં આવે છે."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "נא לא לכלול מידע אישי או מסמכים מקוריים. התשובות נשלחות עם גרסת האפליקציה, גרסת מערכת ההפעלה ומידע על המכשיר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कृपया व्यक्तिगत जानकारी या मूल दस्तावेज़ शामिल न करें। उत्तर आपके ऐप संस्करण, ओएस संस्करण और डिवाइस जानकारी के साथ भेजे जाते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kérjük, ne adjon meg személyes adatokat vagy eredeti dokumentumokat. A válaszokat az alkalmazás verziójával, az operációs rendszer verziójával és az eszközinformációkkal együtt küldjük el."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Harap tidak menyertakan informasi pribadi atau dokumen asli. Jawaban dikirimkan bersama versi aplikasi, versi OS, dan informasi perangkat Anda."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ದಯವಿಟ್ಟು ವೈಯಕ್ತಿಕ ಮಾಹಿತಿ ಅಥವಾ ಮೂಲ ದಾಖಲೆಗಳನ್ನು ಸೇರಿಸಬೇಡಿ. ನಿಮ್ಮ ಅಪ್ಲಿಕೇಶನ್ ಆವೃತ್ತಿ, OS ಆವೃತ್ತಿ ಮತ್ತು ಸಾಧನದ ಮಾಹಿತಿಯೊಂದಿಗೆ ಉತ್ತರಗಳನ್ನು ಕಳುಹಿಸಲಾಗುತ್ತದೆ."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tolong jangan sertakan maklumat peribadi atau dokumen asal. Jawapan dihantar dengan versi apl anda, versi OS dan maklumat peranti."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "വ്യക്തിപരമായ വിവരങ്ങളോ യഥാർത്ഥ രേഖകളോ ഉൾപ്പെടുത്തരുത്. നിങ്ങളുടെ ആപ്പ് പതിപ്പ്, OS പതിപ്പ്, ഉപകരണ വിവരങ്ങൾ എന്നിവയ്‌ക്കൊപ്പം ഉത്തരങ്ങൾ അയയ്‌ക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "कृपया वैयक्तिक माहिती किंवा मूळ कागदपत्रे समाविष्ट करू नका. तुमची ॲप आवृत्ती, OS आवृत्ती आणि डिव्हाइस माहितीसह उत्तरे पाठवली जातात."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vennligst ikke ta med personlig informasjon eller originaldokumenter. Svar sendes med appversjonen, OS-versjonen og enhetsinformasjonen din."
          }
        },
        "or": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ଦୟାକରି ବ୍ୟକ୍ତିଗତ ସୂଚନା କିମ୍ବା ମୂଳ ଡକ୍ୟୁମେଣ୍ଟ ଅନ୍ତର୍ଭୂକ୍ତ କରନ୍ତୁ ନାହିଁ | ଉତ୍ତରଗୁଡିକ ଆପଣଙ୍କର ଆପ୍ ସଂସ୍କରଣ, OS ସଂସ୍କରଣ ଏବଂ ଉପକରଣ ସୂଚନା ସହିତ ପଠାଯାଏ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Proszę nie podawać danych osobowych ani oryginałów dokumentów. Odpowiedzi są wysyłane wraz z wersją aplikacji, wersją systemu operacyjnego i informacjami o urządzeniu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não inclua informações pessoais ou documentos originais. As respostas são enviadas com a versão da sua aplicação, versão do sistema operativo e informações do dispositivo."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ਕਿਰਪਾ ਕਰਕੇ ਨਿੱਜੀ ਜਾਣਕਾਰੀ ਜਾਂ ਅਸਲ ਦਸਤਾਵੇਜ਼ ਸ਼ਾਮਲ ਨਾ ਕਰੋ। ਜਵਾਬ ਤੁਹਾਡੇ ਐਪ ਸੰਸਕਰਣ, OS ਸੰਸਕਰਣ ਅਤੇ ਡਿਵਾਈਸ ਜਾਣਕਾਰੀ ਦੇ ਨਾਲ ਭੇਜੇ ਜਾਂਦੇ ਹਨ।"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vă rugăm să nu includeți informații personale sau documente originale. Răspunsurile sunt trimise cu versiunea aplicației, versiunea sistemului de operare și informațiile despre dispozitiv."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Neuvádzajte osobné údaje ani originálne dokumenty. Odpovede sa odosielajú s verziou vašej aplikácie, verziou operačného systému a informáciami o zariadení."
          }
        },
        "sl": {
          "stringUnit": {
