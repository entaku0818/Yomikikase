    "survey.introduction": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み上げナレーターの使い方を教えてください。いただいた声を今後の改善に役立てます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell us how you use Voice Narrator. Your answers will help us improve the app."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conte como você usa o Voice Narrator. Suas respostas nos ajudarão a melhorar o app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расскажите, как вы используете Voice Narrator. Ваши ответы помогут улучшить приложение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请告诉我们您如何使用Voice Narrator。您的回答将帮助我们改进应用。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie nutzen Sie Voice Narrator? Ihre Antworten helfen uns, die App zu verbessern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuéntanos cómo usas Voice Narrator. Tus respuestas nos ayudarán a mejorar la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dites-nous comment vous utilisez Voice Narrator. Vos réponses nous aideront à améliorer l’app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raccontaci come usi Voice Narrator. Le tue risposte ci aiuteranno a migliorare l’app."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice Narrator를 어떻게 사용하시는지 알려 주세요. 답변은 앱 개선에 도움이 됩니다."
