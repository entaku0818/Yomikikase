          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Γίνεται επαναφορά στο %@. Μπορείτε να συνεχίσετε με τη φωνή της συσκευής σας."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "તે %@ પર રીસેટ થાય છે. તમે તમારા ઉપકરણના અવાજ સાથે ચાલુ રાખી શકો છો."
