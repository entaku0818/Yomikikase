        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tarihinde sıfırlanır. Cihaz sesiyle devam edebilirsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sẽ đặt lại vào %@. Bạn có thể tiếp tục bằng giọng của máy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Renova em %@. Você pode continuar com a voz do dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лимит сбросится %@. Можно продолжить голосом устройства."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将于%@重置。您可以使用设备语音继续朗读。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يتم إعادة تعيينه على %@. يمكنك الاستمرار بصوت جهازك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এটি %@ এ রিসেট হয়। আপনি আপনার ডিভাইসের ভয়েস দিয়ে চালিয়ে যেতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Es reinicia a %@. Pots continuar amb la veu del teu dispositiu."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "它在 %@ 上重置。您可以繼續使用設備的語音。"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ponovno se postavlja na %@. Možete nastaviti s glasom svog uređaja."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Resetuje se na %@. Můžete pokračovat hlasem svého zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den nulstiller på %@. Du kan fortsætte med din enheds stemme."
