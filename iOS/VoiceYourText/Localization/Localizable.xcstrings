        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "זה מתאפס על %@. אתה יכול להמשיך עם הקול של המכשיר שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह %@ पर रीसेट हो जाता है। आप अपने डिवाइस की आवाज़ के साथ जारी रख सकते हैं।"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "%@-n visszaáll. Folytathatja az eszköz hangjával."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ini diatur ulang pada %@. Anda dapat melanjutkan dengan suara perangkat Anda."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ಇದು %@ ನಲ್ಲಿ ಮರುಹೊಂದಿಸುತ್ತದೆ. ನಿಮ್ಮ ಸಾಧನದ ಧ್ವನಿಯೊಂದಿಗೆ ನೀವು ಮುಂದುವರಿಯಬಹುದು."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ia ditetapkan semula pada %@. Anda boleh meneruskan dengan suara peranti anda."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ഇത് %@-ൽ റീസെറ്റ് ചെയ്യുന്നു. നിങ്ങളുടെ ഉപകരണത്തിൻ്റെ ശബ്ദം ഉപയോഗിച്ച് നിങ്ങൾക്ക് തുടരാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "हे %@ वर रीसेट होते. तुम्ही तुमच्या डिव्हाइसच्या आवाजाने सुरू ठेवू शकता."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Den tilbakestilles på %@. Du kan fortsette med enhetens stemme."
          }
        },
        "or": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ଏହା %@ ରେ ପୁନ ets ସେଟ୍ ହୁଏ | ଆପଣ ଆପଣଙ୍କର ଡିଭାଇସ୍ ସ୍ୱର ସହିତ ଜାରି ରଖିପାରିବେ"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Resetuje się na %@. Możesz kontynuować, używając głosu swojego urządzenia."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Reinicia em %@. Pode continuar com a voz do seu dispositivo."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ਇਹ %@ 'ਤੇ ਰੀਸੈੱਟ ਹੁੰਦਾ ਹੈ। ਤੁਸੀਂ ਆਪਣੀ ਡਿਵਾਈਸ ਦੀ ਆਵਾਜ਼ ਨਾਲ ਜਾਰੀ ਰੱਖ ਸਕਦੇ ਹੋ।"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se resetează pe %@. Puteți continua cu vocea dispozitivului dvs."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Resetuje sa na %@. Môžete pokračovať pomocou hlasu svojho zariadenia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ponastavi se na %@. Lahko nadaljujete z glasom svoje naprave."
