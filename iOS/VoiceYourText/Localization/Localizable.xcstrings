          }
        },
        "kn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "... ಹಿಮ ದೇಶವಾಗಿ ಹೊರಹೊಮ್ಮಿತು. ರಾತ್ರಿ ಕೆಳಭಾಗದಲ್ಲಿ ಬಿಳಿ ಬಣ್ಣಕ್ಕೆ ತಿರುಗಿತ್ತು. ಸಿಗ್ನಲ್ ನಿಲ್ದಾಣದಲ್ಲಿ ರೈಲು ನಿಂತಿತು."
          }
        },
        "ms": {
          "stringUnit": {
